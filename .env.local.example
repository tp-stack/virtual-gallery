# Supabase configuration
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api

# Required: your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the publishable key (recommended — format: sb_publishable_...)
# Created in Dashboard → Settings → API → API Keys tab
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_****************

# Legacy fallback (optional — JWT-based anon key from Legacy API Keys tab)
# You can disable the legacy anon key after migrating all clients
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
