{
  "name": "virtual-gallery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-data.js && next dev",
    "build": "node scripts/ensure-data.js && next build",
    "start": "next start",
    "lint": "next lint",
    "import:artworks": "node scripts/import-open-access-artworks.mjs --limit 1000",
    "import:artworks:large": "node scripts/import-open-access-artworks.mjs --limit 5000",
    "import:artworks:max": "node scripts/import-open-access-artworks.mjs --limit 100000",
    "import:artworks:stream": "node scripts/import-open-access-stream.mjs --limit 100000 --source europeana-public-domain --reset",
    "import:artworks:million": "node scripts/import-open-access-stream.mjs --limit 1000000 --source europeana-public-domain --reset",
    "import:artworks:100m": "node scripts/import-open-access-stream.mjs --limit 100000000 --source europeana-open --resume --min-free-gb 2",
    "index:artworks:stream": "node scripts/build-artwork-stream-index.mjs --reset",
    "upload:artworks:stream": "node scripts/import-open-access-stream.mjs --upload-supabase --from-file public/data/artworks.ndjson",
    "upload:artworks:storage": "node scripts/upload-artwork-stream.mjs --target supabase-storage --bucket artwork-exports --prefix artworks/latest --resume",
    "upload:artworks:table": "node scripts/upload-artwork-stream.mjs --target supabase-table --resume",
    "upload:artworks:postgres": "node scripts/upload-artwork-stream.mjs --target postgres-table --table open_access_artworks --state public/data/artwork-upload-postgres-state.json --ensure-schema --resume",
    "upload:artworks:s3": "node scripts/upload-artwork-stream.mjs --target s3 --export-dir public/data/artwork-exports/latest --resume",
    "harvest:artworks:storage:100m": "node scripts/upload-artwork-stream.mjs --target europeana-storage --bucket artwork-exports --prefix artworks/europeana-open --source europeana-open --limit-rows 100000000 --resume",
    "harvest:artworks:postgres:100m": "node scripts/upload-artwork-stream.mjs --target europeana-postgres --table open_access_artworks --state public/data/artwork-harvest-postgres-state.json --source europeana-open --limit-rows 100000000 --ensure-schema --resume",
    "harvest:artworks:public:postgres": "node scripts/upload-artwork-stream.mjs --target public-postgres --table open_access_artworks --source all --ensure-schema --resume",
    "harvest:artworks:public:smoke": "node scripts/upload-artwork-stream.mjs --target public-postgres --table open_access_artworks --source all --limit-rows 1000 --ensure-schema --resume",
    "harvest:artworks:edge": "node scripts/run-edge-harvester.mjs --source europeana-open --rows-per-call 100000 --max-calls 100",
    "harvest:artworks:edge:100m": "node scripts/run-edge-harvester.mjs --source europeana-open --target-rows 100000000 --rows-per-call 100000 --max-calls 1000",
    "export:artworks:chunks": "node scripts/upload-artwork-stream.mjs --target local-volume --output public/data/artwork-exports/latest --reset",
    "check:upload-config": "node scripts/check-upload-config.mjs",
    "db:init": "node scripts/init-fde-db.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:seed": "node scripts/seed-fde-db.mjs",
    "orchestrate": "python agents/run_orchestration.py --phase all",
    "orchestrate:ui": "python agents/run_orchestration.py --phase ui",
    "orchestrate:security": "python agents/run_orchestration.py --phase security",
    "orchestrate:data": "python agents/run_orchestration.py --phase data",
    "orchestrate:components": "python agents/run_orchestration.py --phase generation",
    "orchestrate:verbose": "python agents/run_orchestration.py --phase all --verbose"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/rapier": "^1.4.0",
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "pg": "^8.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
