# Copy this file to deploy/selfhost/.env on the server.
# Do not commit deploy/selfhost/.env.

# First local test URL. Later replace with your domain, for example:
# SITE_ADDRESS=gallery.example.com
SITE_ADDRESS=http://:8088

DATABASE_SCHEMA=app_virtual_gallery

# On the server this app runs with Docker host networking.
# That means 127.0.0.1 reaches the private Postgres port already bound on the server.
# Put the real password into deploy/selfhost/.env on the server only.
DATABASE_URL=postgresql://role_virtual_gallery:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/future_datasets?options=-c%20search_path%3Dapp_virtual_gallery
