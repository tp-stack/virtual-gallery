    {
      "id": "starry-night",
      "title": "The Starry Night",
      "artist": "Vincent van Gogh",
      "year": 1889,
      "movement": "Post-Impressionism",
      "origin": "France",
      "medium": "Oil on canvas",
      "museum": "MoMA, New York",
      "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/ea/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg/1280px-Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg",
      "dimensions": "73.7 cm x 92.1 cm",
      "description": "Van Gogh's swirling nocturnal vision, painted from an asylum window.",
      "description_long": "Painted in June 1889, The Starry Night depicts the view from Van Gogh's east-facing window at the Saint-Paul-de-Mausole asylum in Saint-Remy-de-Provence. The painting captures the night sky with tumultuous swirls of blue and yellow, a village below, and a towering cypress tree reaching toward the heavens.",
      "audio_narration": "This is Van Gogh's Starry Night, painted in 1889 while he was a patient at an asylum in southern France. Look at the sky — those spiraling waves of blue and gold were not what Van Gogh literally saw, but what he felt.",
      "tags": [
        "landscape",
        "Post-Impressionism",
        "night sky",
        "swirling"
      ],
      "highlight": true,
